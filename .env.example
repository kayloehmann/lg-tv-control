TV_HOST=192.168.1.50
BEDROOM_TV_HOST=192.168.1.51
TV_SSH_PORT=22
TV_SSH_USER=root
TV_MAC=02:00:00:00:00:50
BEDROOM_TV_MAC=02:00:00:00:00:51
WOL_BROADCAST=192.168.1.255
PUID=1026
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-this-to-a-long-random-password
SYSTEM_BACKUP_DIR=/data/backups

# Absolute paths on the NAS. Never copy the private key into this repository.
SSH_PRIVATE_KEY_PATH=/volume1/docker/lg-tv-control/secrets/tv_ed25519
SSH_KNOWN_HOSTS_PATH=/volume1/docker/lg-tv-control/secrets/known_hosts
