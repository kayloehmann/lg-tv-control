{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,css,scss}",
      "**/package.json",
      "**/tsconfig*.json",
      "**/jsconfig*.json",
      "**/*.html",
      "biome.json",
      "!!**/node_modules",
      "!!**/.astro",
      "!!**/coverage",
      "!!**/vendor",
      "!**/*.min.*",
      "!**/next-env.d.ts",
      "!!**/dist",
      "!!**/build"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  }
}
